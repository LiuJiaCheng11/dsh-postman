{
  "name": "dsh-postman",
  "version": "0.3.1",
  "description": "dsh 插件 · Postman 云端集合管理：让 AI 查询/新增/删除接口、扫源码自动同步，内置 /postman-skill 技能与「设置 → postman」配置页。",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./postman-api": "./src/postman-api.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dsh-plugin",
    "postman",
    "api",
    "collection",
    "api-testing"
  ],
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/postman-api.js && node --check src/route-scanner.js && node --check src/schemastery.js && node --check src/page.js",
    "test": "node test/smoke.js && node test/scanner.js && node test/settings-page.js",
    "test:real": "bash test/realstart.sh",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USERNAME/dsh-postman.git"
  },
  "homepage": "https://github.com/USERNAME/dsh-postman#readme",
  "bugs": {
    "url": "https://github.com/USERNAME/dsh-postman/issues"
  }
}
